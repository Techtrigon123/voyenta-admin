# Vouchlio Admin — copy to .env.local and fill in. Never commit .env.local.

# Same Supabase project as the Vouchlio app (Supabase → Project Settings → API).
# The service-role key is server-only: never give it a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs admin sessions and encrypts 2-step secrets. Must be DIFFERENT from the Vouchlio app's JWT_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Changing it signs every admin out and resets everyone's 2-step verification.
ADMIN_SESSION_SECRET=

# Address of the Vouchlio agent app — used to build password-reset links for agents.
AGENT_APP_URL=http://localhost:3000

# Razorpay — the SAME key id / secret as the Vouchlio app. Used for refunds, live payment details and
# "Check with Razorpay". Without them the portal still works; online refunds and lookups show a setup message.
# The webhook secret is NOT needed here (webhooks go to the Vouchlio app).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
