# Voyenta Admin — copy to .env.local and fill in. Never commit .env.local.

# Same Supabase project as the Voyenta app (Supabase → Project Settings → API).
# The service-role key is server-only: never give it a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs admin sessions and encrypts 2-step secrets. Must be DIFFERENT from the Voyenta app's JWT_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Changing it signs every admin out and resets everyone's 2-step verification.
ADMIN_SESSION_SECRET=

# Address of the Voyenta agent app — used to build password-reset links for agents.
AGENT_APP_URL=http://localhost:3000
